## Copy this file to .env and fill values. Keep secrets out of source control.
# Local development uses /api through the Vite proxy. Netlify production values
# are pinned in the repository netlify.toml file.
VITE_API_BASE_URL=/api
VITE_BACKEND_WS_URL=http://127.0.0.1:3000
# Optional: override the backend used by Vite's local development proxy.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
VITE_WHATSAPP_NUMBER=919580710941
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_VAPID_KEY=
