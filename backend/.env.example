# Copy this file to .env and fill values. Keep secrets out of source control.
PORT=
NODE_ENV=development
MONGODB_URI=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20
# Optional comma-separated DNS resolvers for MongoDB Atlas mongodb+srv URIs.
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=
BACKEND_URL=
RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=60
CONTACT_RATE_LIMIT_MAX=10
RESEND_API_KEY=
MAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
